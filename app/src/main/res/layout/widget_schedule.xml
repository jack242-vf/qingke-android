<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="轻课 · 今日课表" android:textSize="16sp" android:textStyle="bold" android:textColor="#247565" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="40dp" android:text="刷新" android:textSize="11sp" android:textColor="#247565" android:gravity="center" android:contentDescription="刷新桌面课表" />
    </LinearLayout>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="打开轻课导入课程" android:textSize="11sp" android:textColor="#7C8D78" android:paddingBottom="8dp" />
    <LinearLayout android:id="@+id/widget_courses" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="点击查看课程" android:textSize="9sp" android:textColor="#92A08A" android:maxLines="1" android:ellipsize="end" android:paddingTop="6dp" />
</LinearLayout>
